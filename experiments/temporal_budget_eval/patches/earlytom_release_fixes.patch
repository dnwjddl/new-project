+def extract_multi_choice_prediction(pred):
+    """Parse one unambiguous A-D choice without an external LLM judge."""
+    text = pred.strip()
+    patterns = [
+        r"^\s*([A-D])(?:\s*$|[.)\s:])",
+        r"\b(?:answer|option|choice)\s*(?:is|:)?\s*([A-D])\b",
+    ]
+    for pattern in patterns:
+        match = re.search(pattern, text, flags=re.IGNORECASE)
+        if match:
+            return match.group(1).upper()
+
+    candidates = set(re.findall(r"(?<![A-Za-z])([A-D])(?:[.)]|\b)", text, re.IGNORECASE))
+    if len(candidates) == 1:
+        return candidates.pop().upper()
+    return None
+
